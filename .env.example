# Reserved for the future Supabase phase; not required by the local development backend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Bootstrap the first admin. Create/sign in to a normal account with this Nigerian phone number.
ADMIN_PHONE=+2348012345678

# Geoapify: restrict the browser key to localhost and your production domain.
NEXT_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-browser-key
# Optional separate key for server-side route quotes.
GEOAPIFY_API_KEY=your-geoapify-server-key
